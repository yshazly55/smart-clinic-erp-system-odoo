<odoo>
    <record id="view_clinic_supply_list" model="ir.ui.view">
        <field name="name">clinic.supply.list</field>
        <field name="model">clinic.supply</field>
        <field name="arch" type="xml">
            <list decoration-danger="low_stock">
                <field name="name"/>
                <field name="qty_on_hand"/>
                <field name="min_qty"/>
                <field name="low_stock"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_supply_form" model="ir.ui.view">
        <field name="name">clinic.supply.form</field>
        <field name="model">clinic.supply</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_low_stock_email" type="object" string="Send Low Stock Alert" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="qty_on_hand"/>
                        <field name="min_qty"/>
                        <field name="low_stock" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_supply" model="ir.actions.act_window">
        <field name="name">Medical Supplies</field>
        <field name="res_model">clinic.supply</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
