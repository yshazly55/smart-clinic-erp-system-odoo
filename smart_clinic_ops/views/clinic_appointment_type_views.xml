<odoo>
    <record id="view_clinic_appointment_type_list" model="ir.ui.view">
        <field name="name">clinic.appointment.type.list</field>
        <field name="model">clinic.appointment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="duration_minutes"/>
            </list>
        </field>
    </record>

    <record id="view_clinic_appointment_type_form" model="ir.ui.view">
        <field name="name">clinic.appointment.type.form</field>
        <field name="model">clinic.appointment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="specialization"/>
                        <field name="duration_minutes"/>
                    </group>
                    <notebook>
                        <page string="Required Supplies">
                            <field name="supply_line_ids">
                                <list editable="bottom">
                                    <field name="supply_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_appointment_type" model="ir.actions.act_window">
        <field name="name">Appointment Types</field>
        <field name="res_model">clinic.appointment.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
